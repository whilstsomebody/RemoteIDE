# RemoteIDE Master Environment Configuration Example
NODE_ENV=development
LOG_LEVEL=info

# Gateway Configuration
GATEWAY_PORT=4000
GATEWAY_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=dev-super-secret-jwt-key-min-16-chars

# Host Agent Configuration
AGENT_PORT=4001
AGENT_HOST=127.0.0.1
AGENT_AUTH_TOKEN=dev-agent-token-1234567890
HOST_IDENTIFIER=local-host-agent
SQLITE_JOURNAL_PATH=./data/agent-journal.sqlite

# Infrastructure Connections
DATABASE_URL=postgresql://remoteide:remoteide_dev_pass@localhost:5432/remoteide_db
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092

# Frontend Configuration
NEXT_PUBLIC_GATEWAY_HTTP_URL=http://localhost:4000
NEXT_PUBLIC_GATEWAY_WS_URL=ws://localhost:4000/api/v1/ws

