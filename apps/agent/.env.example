# Host Agent Environment Variables
NODE_ENV=development
PORT=4001
HOST=127.0.0.1
LOG_LEVEL=info

# Gateway Connection
GATEWAY_WS_URL=ws://127.0.0.1:4000/api/v1/tunnel/agent
GATEWAY_HTTP_URL=http://127.0.0.1:4000
# Set the same random secret on gateway and agent for remote/production use.
AGENT_AUTH_TOKEN=
HOST_IDENTIFIER=local-host-agent

# Local Journal & Security Boundaries
SQLITE_JOURNAL_PATH=./data/agent-journal.sqlite
ALLOWED_PROJECT_ROOTS=../..

